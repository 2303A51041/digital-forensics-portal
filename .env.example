# Copy to .env to override. Every value is optional.
PORT=3000
# Holds the SQLite database, uploaded evidence and the generated JWT secret.
DATA_DIR=./data
# If unset, a random secret is generated once and stored in DATA_DIR.
# JWT_SECRET=
JWT_EXPIRES_IN=8h
MAX_UPLOAD_MB=500
# Set to false to start with no demo users or cases (an admin must then be inserted manually).
SEED_DEMO=true
