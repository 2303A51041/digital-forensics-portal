# Copy this file to .env and change values as needed. Every setting has a working default.

# Port for the Express backend API (it also serves the built React app for "npm start").
PORT=5000

# MongoDB connection string.
# Local:  mongodb://localhost:27017/forensics_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/forensics_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/forensics_db

# Secret used to sign login tokens. Leave empty to auto-generate one in DATA_DIR.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Where uploaded evidence files are stored.
DATA_DIR=./server/data

# Largest upload accepted, in megabytes.
MAX_UPLOAD_MB=500

# Origin of the React dev server, allowed through CORS.
CLIENT_ORIGIN=http://localhost:5173

# Create demo users and cases when the database is empty.
SEED_DEMO=true
